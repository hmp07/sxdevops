# SxDevOps ARM64 部署环境变量模板
#
# 使用方法：
#   cp .env.arm64.example .env
#   将下列 change-me 值替换为随机口令（严禁使用示例值）：
#     SECRET_KEY:        openssl rand -hex 32
#     MYSQL_PASSWORD:    openssl rand -hex 16
#     MYSQL_ROOT_PASSWORD: openssl rand -hex 16
#     SXDEVOPS_ADMIN_PASSWORD: openssl rand -hex 16
#
# 注意：.env 含敏感信息，禁止提交版本库（已在 .gitignore 中）。

# Django 密钥（必填，随机 32 字节 hex）
SECRET_KEY=change-me-please-run-openssl-rand-hex-32

# MySQL 业务库口令（必填，随机 16 字节 hex）
MYSQL_PASSWORD=change-me-please-run-openssl-rand-hex-16

# MySQL root 口令（必填，随机 16 字节 hex）
MYSQL_ROOT_PASSWORD=change-me-please-run-openssl-rand-hex-16

# 平台管理员账号口令（必填，随机 16 字节 hex；生产初始化 admin 账号，勿与数据库口令混用）
SXDEVOPS_ADMIN_PASSWORD=change-me-please-run-openssl-rand-hex-16-admin
